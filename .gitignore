# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.hallmark/*

# testing
/coverage

# next.js
/.next/
/out/
.next-dev.stderr.log
.next-dev.stdout.log

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# opennext
.open-next/

# wrangler
.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts
